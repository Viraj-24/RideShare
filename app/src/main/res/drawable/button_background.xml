<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2193b0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#2193b0"
                android:endColor="#6dd5ed"
                android:angle="45" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
